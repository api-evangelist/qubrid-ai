      "name": "Chat Completions",
      "description": {
        "content": "Generate chat-based completions using open-source large language models hosted on NVIDIA GPU infrastructure. Compatible with the OpenAI chat completions request and response format.",
        "type": "text/plain"
      },
      "item": [
