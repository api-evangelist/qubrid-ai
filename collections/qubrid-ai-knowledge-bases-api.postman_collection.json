      "id": "0c1ba588-b948-4856-b914-c95fb422fb6c",
      "name": "Knowledge Bases",
      "description": {
        "content": "Create and manage knowledge bases that store enterprise and departmental data for retrieval-augmented generation. Each knowledge base contains ingested documents that are chunked, embedded, and stored in a vector database for semantic search during inference.",
        "type": "text/plain"
      },
