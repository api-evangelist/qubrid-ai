      "name": "RAG Queries",
      "description": {
        "content": "Query a knowledge base using natural language with retrieval-augmented generation. The API retrieves relevant document chunks from the knowledge base and uses them as context for generating accurate, grounded responses through a large language model.",
        "type": "text/plain"
      },
